# Alpaca Brokerage API (default: paper trading)
ALPACA_MODE=paper
ALPACA_KEY=your_alpaca_api_key
ALPACA_SECRET=your_alpaca_api_secret

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=envotrade
DB_USER=envotrade
DB_PASS=your_strong_db_password

# Anthropic Claude AI (decision & sentiment analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_DECISION_MODEL=claude-haiku-4-5
CLAUDE_SENTIMENT_MODEL=claude-haiku-4-5

# RapidAPI Twitter/X Sentiment Feed (optional)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=twitter-api45.p.rapidapi.com

# Risk & Trading Parameters
SCAN_INTERVAL_SEC=300
AI_CONFIDENCE_THRESHOLD=70
MAX_TRADING_CAPITAL=1000
NOTIONAL_PER_TRADE=100

# US Equities Settings
STOCKS_MARKET_OPEN_ET=09:35
STOCKS_MARKET_CLOSE_ET=15:55
STOCKS_15M_EMA_LEN=50
STOCKS_ATR_STOP_MULT=1.5
STOCKS_ATR_TP_MULT=3.0
STOCKS_SCAN_INTERVAL_SEC=300
